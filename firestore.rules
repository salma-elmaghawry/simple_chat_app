rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Any signed-in user can read profiles (needed for search),
    // but each user can write only their own: users/{uid}.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Only the two people in a chat can read or write it.
    match /chats/{chatId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create, update: if request.auth != null
        && request.auth.uid in request.resource.data.participants;

      // chatId is "uidA_uidB", so it already says who is in the chat.
      match /messages/{messageId} {
        allow read, write: if request.auth != null
          && request.auth.uid in chatId.split('_');
      }
    }
  }
}
